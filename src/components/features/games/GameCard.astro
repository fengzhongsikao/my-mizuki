---
import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";
import type { GameCardProps } from "./types";

const { game } = Astro.props as GameCardProps;

const gameColor = game.color || "#3B82F6";

const buttonColor = "#638046";

const isIconUrl =
	game.avator &&
	(game.avator.startsWith("http://") || game.avator.startsWith("https://"));

const getStatusText = (status: string) => {
	switch (status) {
		case "playing":
			return i18n(I18nKey.gamesStatusPlaying);
		case "completed":
			return i18n(I18nKey.gamesStatusCompleted);
		case "planned":
			return i18n(I18nKey.gamesStatusPlanned);
		case "paused":
			return i18n(I18nKey.gamesStatusPaused);
		case "dropped":
			return i18n(I18nKey.gamesStatusDropped);
		default:
			return status;
	}
};

const getStatusColor = (status: string) => {
	switch (status) {
		case "playing":
			return "text-green-600 dark:text-green-400 bg-green-100 dark:bg-green-900/30";
		case "completed":
			return "text-blue-600 dark:text-blue-400 bg-blue-100 dark:bg-blue-900/30";
		case "planned":
			return "text-purple-600 dark:text-purple-400 bg-purple-100 dark:bg-purple-900/30";
		case "paused":
			return "text-yellow-600 dark:text-yellow-400 bg-yellow-100 dark:bg-yellow-900/30";
		case "dropped":
			return "text-gray-600 dark:text-gray-400 bg-gray-100 dark:bg-gray-900/30";
		default:
			return "text-gray-600 dark:text-gray-400 bg-gray-100 dark:bg-gray-900/30";
	}
};
---

<div
	class="game-card group relative bg-transparent rounded-xl border border-black/10 dark:border-white/10 overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-1 h-full flex flex-col"
	data-category={game.category}
	data-status={game.status}
>
	<div class="p-5 flex flex-col flex-1">
		<div class="flex items-start gap-4 mb-3">
			<div
				class="w-12 h-12 flex-shrink-0 rounded-lg flex items-center justify-center overflow-hidden bg-[var(--btn-regular-bg)]"
			>
				{
					isIconUrl ? (
						<img
							src={game.avator}
							alt={game.name}
							class="w-full h-full object-cover"
							loading="lazy"
						/>
					) : (
						<span
							class="text-xl font-bold"
							style={`color: ${gameColor}`}
						>
							{game.name.charAt(0)}
						</span>
					)
				}
			</div>

			<div class="flex-1 min-w-0">
				<div class="flex items-center justify-between mb-1">
					<h3
						class="text-lg font-bold text-black/90 dark:text-white/90 truncate group-hover:text-[var(--primary)] transition-colors duration-200"
					>
						{game.name}
					</h3>
					<span
						class={`shrink-0 ml-2 px-2 py-0.5 text-xs rounded-md font-medium ${getStatusColor(game.status)}`}
					>
						{getStatusText(game.status)}
					</span>
				</div>
				{
					game.releaseDate && (
						<p class="text-xs text-black/50 dark:text-white/50">
							{i18n(I18nKey.gamesReleaseDate)}: {game.releaseDate}
						</p>
					)
				}
			</div>
		</div>

		<p
			class="text-sm text-black/60 dark:text-white/60 line-clamp-2 min-h-[2.5rem] flex-1"
		>
			{game.description}
		</p>

		<div class="flex flex-wrap gap-2 my-3">
			{
				game.platform.map((p) => (
					<span class="px-2 py-1 text-xs rounded-md bg-[var(--btn-regular-bg)] text-black/50 dark:text-white/50">
						{p}
					</span>
				))
			}
			{
				game.uid && (
					<span
						class="px-2 py-1 text-xs rounded-md font-medium"
						style={`background-color: ${buttonColor}20; color: ${buttonColor}`}
					>
						{i18n(I18nKey.gamesUid)}: {game.uid}
					</span>
				)
			}
		</div>

		{
			(game.uid || game.website) && (
				<div class="flex gap-2">
					{game.uid && (
						<button
							type="button"
							class="copy-uid-btn px-3 py-2 rounded-lg active:scale-95 transition-all duration-200"
							style={`background-color: ${buttonColor}20; color: ${buttonColor}`}
							data-copy-uid={game.uid}
							title={i18n(I18nKey.gamesCopyUid)}
						>
							<svg
								class="w-4 h-4"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
								/>
							</svg>
						</button>
					)}
					{game.website && (
						<a
							href={game.website}
							target="_blank"
							rel="noopener noreferrer"
							class="flex-1 flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-white active:scale-95 transition-all duration-200 font-medium text-sm"
							style={`background-color: ${buttonColor}`}
						>
							<svg
								class="w-4 h-4"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
								/>
							</svg>
							{i18n(I18nKey.gamesWebsite)}
						</a>
					)}
				</div>
			)
		}
	</div>

	<div
		class="absolute inset-0 bg-gradient-to-br from-[var(--primary)]/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
	>
	</div>
</div>

<script>
	function initGameCardCopy() {
		document
			.querySelectorAll<HTMLButtonElement>("[data-copy-uid]")
			.forEach((btn) => {
				if (btn.dataset.copyUidBound) return;
				btn.dataset.copyUidBound = "true";
				btn.addEventListener("click", async () => {
					const uid = btn.dataset.copyUid;
					if (!uid) return;
					try {
						await navigator.clipboard.writeText(uid);
						btn.style.color = "#22c55e";
						setTimeout(() => (btn.style.color = ""), 1500);
					} catch {
						// fallback
					}
				});
			});
	}

	initGameCardCopy();
	document.addEventListener("astro:page-load", initGameCardCopy);
</script>

<style>
	.game-card {
		animation: fadeInUp 0.5s ease-out forwards;
		opacity: 0;
	}

	.game-card.filtered-out {
		display: none;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.game-card:nth-child(1) {
		animation-delay: 0.03s;
	}
	.game-card:nth-child(2) {
		animation-delay: 0.06s;
	}
	.game-card:nth-child(3) {
		animation-delay: 0.09s;
	}
	.game-card:nth-child(4) {
		animation-delay: 0.12s;
	}
	.game-card:nth-child(5) {
		animation-delay: 0.15s;
	}
	.game-card:nth-child(6) {
		animation-delay: 0.18s;
	}
	.game-card:nth-child(7) {
		animation-delay: 0.21s;
	}
	.game-card:nth-child(8) {
		animation-delay: 0.24s;
	}
	.game-card:nth-child(9) {
		animation-delay: 0.27s;
	}
	.game-card:nth-child(10) {
		animation-delay: 0.3s;
	}
	.game-card:nth-child(11) {
		animation-delay: 0.33s;
	}
	.game-card:nth-child(12) {
		animation-delay: 0.36s;
	}

	.line-clamp-2 {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
